# Aapla Kayda - Advocate Pratiksha AI Legal Platform
# Configuration & Environment Variables

# Server Ports
PORT=5050
VIDEO_STUDIO_PORT=5055
FRONTEND_PORT=3000

# Security PIN for Remote Mobile Access (Optional, default: 2026)
DASHBOARD_ACCESS_PIN=2026

# AI Generation Engine (Google Gemini API)
# Get your free key from: https://aistudio.google.com/
GEMINI_API_KEY=

# Instagram Graph API Integration (Optional for Live Analytics)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Environment
NODE_ENV=production
